#!/usr/bin/env bash
# Runs what CI runs, before anything leaves this machine (skip once: git push --no-verify).
set -euo pipefail
root="$(git rev-parse --show-toplevel)"

# files touched by the commits being pushed (stdin: <local ref> <local sha> <remote ref> <remote sha>)
changed=""
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"; base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
    [ -n "$base" ] && range="$base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  changed+="$(git diff --name-only "$range" 2>/dev/null || true)"$'\n'
done

if [ -z "${changed//$'\n'/}" ]; then exit 0; fi

if grep -qE '^(server/|install\.sh|\.github/)' <<<"$changed"; then
  echo "▸ server: types · lint · tests"
  cd "$root/server"
  bun run check-types
  bun run lint
  bun test
  bash -n "$root/install.sh"
fi

if grep -qE '^ios/' <<<"$changed"; then
  echo "▸ ios: build"
  cd "$root/ios"
  command -v xcodegen >/dev/null && xcodegen generate -q
  xcodebuild -project Hollr.xcodeproj -scheme Hollr -destination 'generic/platform=iOS Simulator' -quiet build \
    2>&1 | grep -v "failed with exit code 0 but produced no further output" \
    | grep -E "error:|BUILD FAILED" && { echo "✘ iOS-Build fehlgeschlagen"; exit 1; }
  # what the mac workflow builds (Catalyst, Release): it failed there when an expression was too slow
  # to type-check on the CI machines – anything over 300 ms here counts as a failure
  echo "▸ ios: Mac (Catalyst, Release) like CI"
  log="$(mktemp)"
  xcodebuild -project Hollr.xcodeproj -scheme Hollr -configuration Release \
    -destination 'generic/platform=macOS,variant=Mac Catalyst' ARCHS=arm64 ONLY_ACTIVE_ARCH=NO CODE_SIGNING_ALLOWED=NO \
    OTHER_SWIFT_FLAGS='$(inherited) -Xfrontend -warn-long-expression-type-checking=300 -Xfrontend -warn-long-function-bodies=300' \
    -derivedDataPath build/dd-prepush build >"$log" 2>&1 || true
  if grep -v "failed with exit code 0 but produced no further output" "$log" | grep -E "error:|BUILD FAILED|ms to type-check" \
    | sed 's|.*/Sources/|Sources/|' | sort -u; then
    echo "✘ Mac-Build (wie CI) fehlgeschlagen – zu langsame Ausdrücke in kleinere Teile zerlegen"
    rm -f "$log"
    exit 1
  fi
  rm -f "$log"
fi
if grep -qE '^desktop/' <<<"$changed"; then
  echo "▸ desktop: svelte-check · cargo check"
  cd "$root/desktop"
  bun run check >/dev/null
  (cd src-tauri && cargo check -q)
fi
echo "✔ pre-push ok"
