    "Das Pane „%@“ wird in herdr auf %@ geschlossen und %@ beendet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Das Pane „%1$@“ wird in herdr auf %2$@ geschlossen und %3$@ beendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pane “%1$@” will be closed in herdr on %2$@ and %3$@ will be stopped."
          }
        }
      }
    },
    "Das ist kein Hollr-Kopplungscode.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a Hollr pairing code."
          }
        }
      }
