<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>UIBackgroundModes</key>
  <array><string>audio</string></array>
  <key>HollrTeamID</key><string>$(DEVELOPMENT_TEAM)</string>
  <key>NSAppTransportSecurity</key>
  <dict>
    <!-- in-app browser: dev/test pages are often plain http; only affects WKWebView content -->
    <key>NSAllowsArbitraryLoadsInWebContent</key><true/>
    <key>NSAllowsLocalNetworking</key><true/>
  </dict>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key><string>app.hollr.pair</string>
      <key>CFBundleURLSchemes</key><array><string>hollr</string></array>
    </dict>
  </array>
</dict>
</plist>
